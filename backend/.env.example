# PostgreSQL
POSTGRES_USER=immigration
POSTGRES_PASSWORD=
POSTGRES_DB=immigration_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

SECRET_KEY=

# Tài khoản admin mặc định (tạo/cập nhật khi khởi động backend)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Ước tính chi phí USD / 1M token (tùy model)
OPENAI_INPUT_COST_PER_1M=0.15
OPENAI_OUTPUT_COST_PER_1M=0.60
# Ngân sách token/tháng (0 = không giới hạn)
MONTHLY_TOKEN_BUDGET=0

# Lưu trữ document/export qua MinIO (S3-compatible) — chạy `docker compose up minio` ở repo
# root trước. Để trống S3_ENDPOINT_URL thì backend dùng lại đĩa cục bộ (backend/uploads,
# backend/exports) như trước, không cần MinIO — xem app/config.py (s3_enabled).
# S3_ACCESS_KEY/S3_SECRET_KEY PHẢI được điền giá trị thật (không dùng cú pháp ${...} — .env
# không tự expand biến), và phải khớp với MINIO_ROOT_USER/PASSWORD của container minio
# (xem docker-compose.yml ở repo root).
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=immipath-documents
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

APP_BASE_URL=http://localhost:3000

# Email thông báo (để trống = chỉ thông báo trong app)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@immipath.local
SMTP_USE_TLS=true

OCR_WORKSHEET_ROWS=1
OCR_WORKSHEET_COLS=1

# Turn on/off for OCR handwriting for docs
OCR_HANDWRITING_CORRECTION_RULES_DS260_CUSTOMER_FORM=true
OCR_HANDWRITING_CORRECTION_RULES_BIRTH_CERTIFICATE=true
OCR_HANDWRITING_CORRECTION_RULES_BIRTH_CERTIFICATE_CHILD=true
OCR_CONSENSUS_RUNS=3