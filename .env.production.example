# === Copy to .env.production and edit before deploy ===
# cp .env.production.example .env.production

# Public URL (domain or IP of your server)
DOMAIN=your-server.example.com
HTTPS_PORT=2026
HTTP_PORT=80
# Truy cập trực tiếp frontend (LAN): http://IP:3000/login
FRONTEND_PORT=3000

# TLS_MODE:
#   internal — self-signed (test / IP, trình duyệt cảnh báo)
#   auto     — Let's Encrypt (cần DOMAIN trỏ DNS + mở port 80)
#   custom   — chứng chỉ có sẵn trong deploy/certs/
TLS_MODE=internal
ACME_EMAIL=admin@your-server.example.com

# PostgreSQL
POSTGRES_USER=immigration
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=immigration_ai

# Backend
SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1
# Endpoint OpenAI-compatible cho chat (OpenRouter, Gemini compat...). Trống = OpenAI.
OPENAI_BASE_URL=

# --- OCR tài liệu (worksheet DS-260 viết tay) ---
# VISION_MODEL: model đọc ảnh. Trống → dùng OPENAI_MODEL.
# Worksheet khách khai là bản SCAN VIẾT TAY → nên đặt model vision mạnh.
#   OpenAI:     VISION_MODEL=gpt-4o
#   OpenRouter: VISION_MODEL=google/gemini-2.5-pro + OCR_BASE_URL=https://openrouter.ai/api/v1
# OCR_API_KEY / OCR_BASE_URL: để chạy OCR ở provider khác chat. Trống → kế thừa OPENAI_*.
VISION_MODEL=
OCR_API_KEY=
OCR_BASE_URL=

# Cắt mỗi trang worksheet viết tay thành lưới trước khi gửi Vision API.
# Chữ tay nét hơn, NHƯNG token mỗi request tăng theo số ảnh, mà OpenAI áp trần
# tokens-per-minute cho TỪNG request — vượt trần là 429 vĩnh viễn, retry vô ích.
# Đo trên worksheet 20 trang, tài khoản tier 30k TPM:
#   ROWS=1 → ~22k token (lọt) | ROWS=2 → ~31k (429) | ROWS=4 → ~116k (429)
# Xem trần của bạn ở header `x-ratelimit-limit-tokens` khi gọi API.
# Để 1 = tắt. Chỉ tăng khi tài khoản ở tier cao hơn.
OCR_WORKSHEET_ROWS=1
OCR_WORKSHEET_COLS=1

# Số ảnh tối đa mỗi request Vision API. Tài liệu nhiều ảnh hơn sẽ được chia thành
# nhiều request nối tiếp rồi gộp kết quả (giá trị khác rỗng đầu tiên thắng).
# 20 ảnh nguyên trang ≈ 22k token, lọt trần 30k TPM. 0 = không chia.
OCR_MAX_IMAGES_PER_REQUEST=20

OPENAI_INPUT_COST_PER_1M=0.15
OPENAI_OUTPUT_COST_PER_1M=0.60
MONTHLY_TOKEN_BUDGET=0

# Admin (tạo/cập nhật khi backend khởi động)
ADMIN_EMAIL=it.admin@edupath.org.vn
ADMIN_PASSWORD=change-me-admin-password

# Email (tùy chọn)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@immipath.local
SMTP_USE_TLS=true
